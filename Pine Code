//@version=6
indicator("Opening Range Levels + 5M Trade Map", overlay=true, max_lines_count=100, max_labels_count=100)

//─────────────────────────────────────
// INPUTS
//─────────────────────────────────────
openPrice = input.float(4400.0, "Gold Opening Price", step=0.01)
GVZopen   = input.float(20.0, "GVZ Opening", minval=0.01, step=0.01)

extendBars = input.int(30, "Trade Lines Length", minval=5)

//─────────────────────────────────────
// RANGE CALCULATION
//─────────────────────────────────────
rangeVal = (GVZopen / 15.87) * openPrice / 100

//─────────────────────────────────────
// LEVELS
//─────────────────────────────────────
U25  = openPrice + rangeVal * 0.25
U50  = openPrice + rangeVal * 0.50
U75  = openPrice + rangeVal * 0.75
U100 = openPrice + rangeVal

D25  = openPrice - rangeVal * 0.25
D50  = openPrice - rangeVal * 0.50
D75  = openPrice - rangeVal * 0.75
D100 = openPrice - rangeVal

//─────────────────────────────────────
// PLOTS
//─────────────────────────────────────
plot(openPrice, "Opening", color=color.yellow)

plot(U25, "+25%", color=color.green)
plot(U50, "+50%", color=color.green)
plot(U75, "+75%", color=color.green)
plot(U100, "+100%", color=color.green)

plot(D25, "-25%", color=color.red)
plot(D50, "-50%", color=color.red)
plot(D75, "-75%", color=color.red)
plot(D100, "-100%", color=color.red)

//─────────────────────────────────────
// LEVEL ARRAY
//─────────────────────────────────────
var levels = array.new_float(9)

array.set(levels, 0, D100)
array.set(levels, 1, D75)
array.set(levels, 2, D50)
array.set(levels, 3, D25)
array.set(levels, 4, openPrice)
array.set(levels, 5, U25)
array.set(levels, 6, U50)
array.set(levels, 7, U75)
array.set(levels, 8, U100)

//─────────────────────────────────────
// 5 MINUTE ONLY
//─────────────────────────────────────
is5M = timeframe.isminutes and timeframe.multiplier == 5

//─────────────────────────────────────
// ACTIVE TRADE STATE
//─────────────────────────────────────
var bool longActive  = false
var bool shortActive = false

var float longSL  = na
var float longTP1 = na

var float shortSL  = na
var float shortTP1 = na

//─────────────────────────────────────
// CHECK IF ACTIVE BUY IS FINISHED
//─────────────────────────────────────
if longActive

    // TP1 reached
    if high >= longTP1
        longActive := false
        longSL := na
        longTP1 := na

    // SL / signal low broken
    else if low < longSL
        longActive := false
        longSL := na
        longTP1 := na

//─────────────────────────────────────
// CHECK IF ACTIVE SELL IS FINISHED
//─────────────────────────────────────
if shortActive

    // TP1 reached
    if low <= shortTP1
        shortActive := false
        shortSL := na
        shortTP1 := na

    // SL / signal high broken
    else if high > shortSL
        shortActive := false
        shortSL := na
        shortTP1 := na

//─────────────────────────────────────
// SEARCH FOR BUY SIGNAL
// ONLY IF NO BUY IS ACTIVE
//─────────────────────────────────────
int buyIndex = na

if is5M and not longActive

    for x = 0 to 8

        i = 8 - x
        lvl = array.get(levels, i)

        approachingFromAbove = close[1] > lvl
        touched = low <= lvl
        rejectedUp = close > lvl

        if approachingFromAbove and touched and rejectedUp and na(buyIndex)
            buyIndex := i

//─────────────────────────────────────
// SEARCH FOR SELL SIGNAL
// ONLY IF NO SELL IS ACTIVE
//─────────────────────────────────────
int sellIndex = na

if is5M and not shortActive

    for i = 0 to 8

        lvl = array.get(levels, i)

        approachingFromBelow = close[1] < lvl
        touched = high >= lvl
        rejectedDown = close < lvl

        if approachingFromBelow and touched and rejectedDown and na(sellIndex)
            sellIndex := i

//─────────────────────────────────────
// DON'T ALLOW BUY + SELL SAME CANDLE
//─────────────────────────────────────
if not na(buyIndex) and not na(sellIndex)
    buyIndex := na
    sellIndex := na

longSignal  = not na(buyIndex)
shortSignal = not na(sellIndex)

//─────────────────────────────────────
// TRADE DRAWINGS
//─────────────────────────────────────
var line[] tradeLines = array.new_line()
var label[] tradeLabels = array.new_label()

clearTrade() =>
    if array.size(tradeLines) > 0
        for i = 0 to array.size(tradeLines) - 1
            line.delete(array.get(tradeLines, i))
        array.clear(tradeLines)

    if array.size(tradeLabels) > 0
        for i = 0 to array.size(tradeLabels) - 1
            label.delete(array.get(tradeLabels, i))
        array.clear(tradeLabels)

drawTradeLine(price, txt, clr) =>
    l = line.new(
         bar_index,
         price,
         bar_index + extendBars,
         price,
         color=clr,
         width=2)

    array.push(tradeLines, l)

    lab = label.new(
         bar_index + extendBars,
         price,
         txt,
         style=label.style_label_left,
         color=clr,
         textcolor=color.white)

    array.push(tradeLabels, lab)

//─────────────────────────────────────
// NEW BUY TRADE
//─────────────────────────────────────
if longSignal

    clearTrade()

    entry = close
    sl = low

    float tp1 = na

    // Find first level above entry
    for i = 0 to 8
        lvl = array.get(levels, i)

        if lvl > entry and na(tp1)
            tp1 := lvl

    // Activate trade only if TP exists
    if not na(tp1)

        longActive := true
        longSL := sl
        longTP1 := tp1

        drawTradeLine(
             entry,
             "BUY ENTRY  " + str.tostring(entry, format.mintick),
             color.blue)

        drawTradeLine(
             sl,
             "SL  " + str.tostring(sl, format.mintick),
             color.red)

        risk = entry - sl

        int tpCount = 0

        for i = 0 to 8

            lvl = array.get(levels, i)

            if lvl > entry and tpCount < 4

                tpCount += 1

                profit = lvl - entry
                rr = risk > 0 ? profit / risk : na

                drawTradeLine(
                     lvl,
                     "TP" + str.tostring(tpCount) +
                     "  " + str.tostring(lvl, format.mintick) +
                     "  +" + str.tostring(profit, "#.##") +
                     "  (" + str.tostring(rr, "#.##") + "R)",
                     color.green)

//─────────────────────────────────────
// NEW SELL TRADE
//─────────────────────────────────────
if shortSignal

    clearTrade()

    entry = close
    sl = high

    float tp1 = na

    // Find first level below entry
    for x = 0 to 8

        i = 8 - x
        lvl = array.get(levels, i)

        if lvl < entry and na(tp1)
            tp1 := lvl

    // Activate trade only if TP exists
    if not na(tp1)

        shortActive := true
        shortSL := sl
        shortTP1 := tp1

        drawTradeLine(
             entry,
             "SELL ENTRY  " + str.tostring(entry, format.mintick),
             color.blue)

        drawTradeLine(
             sl,
             "SL  " + str.tostring(sl, format.mintick),
             color.red)

        risk = sl - entry

        int tpCount = 0

        for x = 0 to 8

            i = 8 - x
            lvl = array.get(levels, i)

            if lvl < entry and tpCount < 4

                tpCount += 1

                profit = entry - lvl
                rr = risk > 0 ? profit / risk : na

                drawTradeLine(
                     lvl,
                     "TP" + str.tostring(tpCount) +
                     "  " + str.tostring(lvl, format.mintick) +
                     "  +" + str.tostring(profit, "#.##") +
                     "  (" + str.tostring(rr, "#.##") + "R)",
                     color.green)

//─────────────────────────────────────
// SIGNAL MARKERS
//─────────────────────────────────────
plotshape(
     longSignal,
     title="BUY",
     location=location.belowbar,
     style=shape.triangleup,
     color=color.lime,
     size=size.small,
     text="BUY")

plotshape(
     shortSignal,
     title="SELL",
     location=location.abovebar,
     style=shape.triangledown,
     color=color.red,
     size=size.small,
     text="SELL")
