//@version=6
indicator("Opening Range Trade Map - Single Day Germany v6", overlay=true,
     max_lines_count=500, max_labels_count=500, max_boxes_count=500)
//────────────────────────────────────────────
// INPUTS
//────────────────────────────────────────────
selectedTradingDate = input.time(
     defval=timestamp("20 Aug 2026 00:00 +0200"),
     title="Trading Date (Germany)")

string germanTimezone = "Europe/Berlin"
selectedYear = year(selectedTradingDate, germanTimezone)
selectedMonth = month(selectedTradingDate, germanTimezone)
selectedDay = dayofmonth(selectedTradingDate, germanTimezone)

// The time selected in the date picker is ignored. Each chosen German date
// automatically runs from 00:00 until 23:00 Europe/Berlin time.
openingTime = timestamp(germanTimezone, selectedYear, selectedMonth, selectedDay, 0, 0)
closingTime = timestamp(germanTimezone, selectedYear, selectedMonth, selectedDay, 23, 0)
selectedSessionActive = time >= openingTime and time < closingTime
selectedSessionClosingBar = time < closingTime and time_close >= closingTime
// GVZopen = input.float(20.0, "GVZ Opening", minval=0.01, step=0.01)
// string volatilitySymbol = "VANTAGE:VIX"
// GVZopenA = request.security(
//      volatilitySymbol,
//      "D",
//      open,
//      gaps=barmerge.gaps_off,
//      lookahead=barmerge.lookahead_off)
GVZopenA = input.float(
     17.525,
     "VIX Opening Value",
     minval=0.01,
     step=0.001)
signalMinutes = input.int(5, "Signal Timeframe (Minutes)", options=[3, 5])
previousDayRangeThreshold = input.float(
     85.0,
     "Previous Day Range Threshold ($)",
     minval=1.0,
     step=1.0)
minimumTP1RewardRisk = input.float(
     1.2,
     "Minimum TP1 Reward/Risk",
     minval=0.1,
     step=0.1)
initialSLOffset = input.float(
     0.625,
     "Initial SL Offset ($)",
     minval=0.001,
     step=0.001)
candles = signalMinutes == 5 ? 276 : 460
// Capture the opening price internally from 5-minute data. This keeps the
// selected opening available when the chart is switched between 3M and 5M.
selectedOpen5M = request.security(
     syminfo.tickerid,
     "5",
     time <= openingTime and time_close > openingTime ? open : na,
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)
var float openPrice = na
if not na(selectedOpen5M)
    openPrice := selectedOpen5M


//Auto range
previousDayHigh = request.security(
     syminfo.tickerid, "D", high[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)
previousDayLow = request.security(
     syminfo.tickerid, "D", low[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on)
previousDayPriceRange = previousDayHigh - previousDayLow
previousDayRange = previousDayPriceRange * 100
// Freeze the previous-day range on the selected opening candle. The VIX value
// is supplied manually through the input above and therefore remains fixed.
isSelectedOpeningBar = time <= openingTime and time_close > openingTime
var float fixedPreviousDayPriceRange = na
var float fixedPreviousDayRange = na
if isSelectedOpeningBar
    fixedPreviousDayPriceRange := previousDayPriceRange
    fixedPreviousDayRange := previousDayRange
lowRangeMode = fixedPreviousDayPriceRange < previousDayRangeThreshold
// After TP1, every trailing step is always 12.5% in both range modes.
trailingOffsetFactor = 0.125
rangeSource = input.string(
     "Volatility Index",
     "Range Source",
     options=["Volatility Index", "Previous Day Range"])
GVZopen = rangeSource == "Volatility Index" ? GVZopenA : fixedPreviousDayRange


//────────────────────────────────────────────
// RANGE
//────────────────────────────────────────────
rangeValA = (GVZopen / 15.87) * openPrice / 100
rangeValB = (GVZopen / candles)*1
rangeVal = GVZopen < 50 ? rangeValA : rangeValB
// Cross-check panel for the two available range sources.
var table rangeInfo = table.new(
     position.top_right, 2, 2,
     bgcolor=color.new(color.black, 15),
     frame_color=color.gray,
     frame_width=1)
if barstate.islast
    table.cell(rangeInfo, 0, 0, "VIX opening", text_color=color.white)
    table.cell(rangeInfo, 1, 0, str.tostring(GVZopenA, "#.###"), text_color=color.aqua)
    table.cell(rangeInfo, 0, 1, "Previous H-L ($)", text_color=color.white)
    table.cell(rangeInfo, 1, 1, str.tostring(fixedPreviousDayPriceRange*100, format.mintick), text_color=color.aqua)
//────────────────────────────────────────────
// LEVELS
//────────────────────────────────────────────
U25  = openPrice + rangeVal * 0.25
U50  = openPrice + rangeVal * 0.50
U75  = openPrice + rangeVal * 0.75
U100 = openPrice + rangeVal
U125 = openPrice + rangeVal * 1.25
U150 = openPrice + rangeVal * 1.50
U175 = openPrice + rangeVal * 1.75
U200 = openPrice + rangeVal * 2.00
U225 = openPrice + rangeVal * 2.25
U250 = openPrice + rangeVal * 2.50
U275 = openPrice + rangeVal * 2.75
U300 = openPrice + rangeVal * 3.00
U325 = openPrice + rangeVal * 3.25
U350 = openPrice + rangeVal * 3.50
U375 = openPrice + rangeVal * 3.75
U400 = openPrice + rangeVal * 4.00
U425 = openPrice + rangeVal * 4.25
U450 = openPrice + rangeVal * 4.50
U475 = openPrice + rangeVal * 4.75
U500 = openPrice + rangeVal * 5.00
// Reveal the next 100% band only after a candle closes beyond the prior 100%.
var bool upperBand1Active = false
var bool upperBand2Active = false
var bool upperBand3Active = false
var bool upperBand4Active = false
if selectedSessionActive and not na(U100) and close > U100
    upperBand1Active := true
if selectedSessionActive and not na(U200) and close > U200
    upperBand2Active := true
if selectedSessionActive and not na(U300) and close > U300
    upperBand3Active := true
if selectedSessionActive and not na(U400) and close > U400
    upperBand4Active := true
D25  = openPrice - rangeVal * 0.25
D50  = openPrice - rangeVal * 0.50
D75  = openPrice - rangeVal * 0.75
D100 = openPrice - rangeVal
D125 = openPrice - rangeVal * 1.25
D150 = openPrice - rangeVal * 1.50
D175 = openPrice - rangeVal * 1.75
D200 = openPrice - rangeVal * 2.00
D225 = openPrice - rangeVal * 2.25
D250 = openPrice - rangeVal * 2.50
D275 = openPrice - rangeVal * 2.75
D300 = openPrice - rangeVal * 3.00
D325 = openPrice - rangeVal * 3.25
D350 = openPrice - rangeVal * 3.50
D375 = openPrice - rangeVal * 3.75
D400 = openPrice - rangeVal * 4.00
D425 = openPrice - rangeVal * 4.25
D450 = openPrice - rangeVal * 4.50
D475 = openPrice - rangeVal * 4.75
D500 = openPrice - rangeVal * 5.00
var bool lowerBand1Active = false
var bool lowerBand2Active = false
var bool lowerBand3Active = false
var bool lowerBand4Active = false
if selectedSessionActive and not na(D100) and close < D100
    lowerBand1Active := true
if selectedSessionActive and not na(D200) and close < D200
    lowerBand2Active := true
if selectedSessionActive and not na(D300) and close < D300
    lowerBand3Active := true
if selectedSessionActive and not na(D400) and close < D400
    lowerBand4Active := true
//────────────────────────────────────────────
// MAIN LEVEL PLOTS
//────────────────────────────────────────────
plot(selectedSessionActive ? openPrice : na, "Opening", color=color.yellow)
plot(selectedSessionActive ? U25 : na, "+25%", color=color.green)
plot(selectedSessionActive ? U50 : na, "+50%", color=color.green)
plot(selectedSessionActive ? U75 : na, "+75%", color=color.green)
plot(selectedSessionActive ? U100 : na, "+100%", color=color.green)
plot(selectedSessionActive and upperBand1Active ? U125 : na, "+125%", color=color.aqua)
plot(selectedSessionActive and upperBand1Active ? U150 : na, "+150%", color=color.aqua)
plot(selectedSessionActive and upperBand1Active ? U175 : na, "+175%", color=color.aqua)
plot(selectedSessionActive and upperBand1Active ? U200 : na, "+200%", color=color.aqua)
plot(selectedSessionActive and upperBand2Active ? U225 : na, "+225%", color=color.blue)
plot(selectedSessionActive and upperBand2Active ? U250 : na, "+250%", color=color.blue)
plot(selectedSessionActive and upperBand2Active ? U275 : na, "+275%", color=color.blue)
plot(selectedSessionActive and upperBand2Active ? U300 : na, "+300%", color=color.blue)
plot(selectedSessionActive and upperBand3Active ? U325 : na, "+325%", color=color.aqua)
plot(selectedSessionActive and upperBand3Active ? U350 : na, "+350%", color=color.aqua)
plot(selectedSessionActive and upperBand3Active ? U375 : na, "+375%", color=color.aqua)
plot(selectedSessionActive and upperBand3Active ? U400 : na, "+400%", color=color.aqua)
plot(selectedSessionActive and upperBand4Active ? U425 : na, "+425%", color=color.blue)
plot(selectedSessionActive and upperBand4Active ? U450 : na, "+450%", color=color.blue)
plot(selectedSessionActive and upperBand4Active ? U475 : na, "+475%", color=color.blue)
plot(selectedSessionActive and upperBand4Active ? U500 : na, "+500%", color=color.blue)
plot(selectedSessionActive ? D25 : na, "-25%", color=color.red)
plot(selectedSessionActive ? D50 : na, "-50%", color=color.red)
plot(selectedSessionActive ? D75 : na, "-75%", color=color.red)
plot(selectedSessionActive ? D100 : na, "-100%", color=color.red)
plot(selectedSessionActive and lowerBand1Active ? D125 : na, "-125%", color=color.orange)
plot(selectedSessionActive and lowerBand1Active ? D150 : na, "-150%", color=color.orange)
plot(selectedSessionActive and lowerBand1Active ? D175 : na, "-175%", color=color.orange)
plot(selectedSessionActive and lowerBand1Active ? D200 : na, "-200%", color=color.orange)
plot(selectedSessionActive and lowerBand2Active ? D225 : na, "-225%", color=color.purple)
plot(selectedSessionActive and lowerBand2Active ? D250 : na, "-250%", color=color.purple)
plot(selectedSessionActive and lowerBand2Active ? D275 : na, "-275%", color=color.purple)
plot(selectedSessionActive and lowerBand2Active ? D300 : na, "-300%", color=color.purple)
plot(selectedSessionActive and lowerBand3Active ? D325 : na, "-325%", color=color.orange)
plot(selectedSessionActive and lowerBand3Active ? D350 : na, "-350%", color=color.orange)
plot(selectedSessionActive and lowerBand3Active ? D375 : na, "-375%", color=color.orange)
plot(selectedSessionActive and lowerBand3Active ? D400 : na, "-400%", color=color.orange)
plot(selectedSessionActive and lowerBand4Active ? D425 : na, "-425%", color=color.purple)
plot(selectedSessionActive and lowerBand4Active ? D450 : na, "-450%", color=color.purple)
plot(selectedSessionActive and lowerBand4Active ? D475 : na, "-475%", color=color.purple)
plot(selectedSessionActive and lowerBand4Active ? D500 : na, "-500%", color=color.purple)
//────────────────────────────────────────────
// LEVEL ARRAY
// LOWEST → HIGHEST
//────────────────────────────────────────────
var levels = array.new_float(41)
array.set(levels, 0, lowerBand4Active ? D500 : na)
array.set(levels, 1, lowerBand4Active ? D475 : na)
array.set(levels, 2, lowerBand4Active ? D450 : na)
array.set(levels, 3, lowerBand4Active ? D425 : na)
array.set(levels, 4, lowerBand3Active ? D400 : na)
array.set(levels, 5, lowerBand3Active ? D375 : na)
array.set(levels, 6, lowerBand3Active ? D350 : na)
array.set(levels, 7, lowerBand3Active ? D325 : na)
array.set(levels, 8, lowerBand2Active ? D300 : na)
array.set(levels, 9, lowerBand2Active ? D275 : na)
array.set(levels, 10, lowerBand2Active ? D250 : na)
array.set(levels, 11, lowerBand2Active ? D225 : na)
array.set(levels, 12, lowerBand1Active ? D200 : na)
array.set(levels, 13, lowerBand1Active ? D175 : na)
array.set(levels, 14, lowerBand1Active ? D150 : na)
array.set(levels, 15, lowerBand1Active ? D125 : na)
array.set(levels, 16, D100)
array.set(levels, 17, D75)
array.set(levels, 18, D50)
array.set(levels, 19, D25)
array.set(levels, 20, openPrice)
array.set(levels, 21, U25)
array.set(levels, 22, U50)
array.set(levels, 23, U75)
array.set(levels, 24, U100)
array.set(levels, 25, upperBand1Active ? U125 : na)
array.set(levels, 26, upperBand1Active ? U150 : na)
array.set(levels, 27, upperBand1Active ? U175 : na)
array.set(levels, 28, upperBand1Active ? U200 : na)
array.set(levels, 29, upperBand2Active ? U225 : na)
array.set(levels, 30, upperBand2Active ? U250 : na)
array.set(levels, 31, upperBand2Active ? U275 : na)
array.set(levels, 32, upperBand2Active ? U300 : na)
array.set(levels, 33, upperBand3Active ? U325 : na)
array.set(levels, 34, upperBand3Active ? U350 : na)
array.set(levels, 35, upperBand3Active ? U375 : na)
array.set(levels, 36, upperBand3Active ? U400 : na)
array.set(levels, 37, upperBand4Active ? U425 : na)
array.set(levels, 38, upperBand4Active ? U450 : na)
array.set(levels, 39, upperBand4Active ? U475 : na)
array.set(levels, 40, upperBand4Active ? U500 : na)
lastLevelIndex = array.size(levels) - 1
//────────────────────────────────────────────
// SELECTED SIGNAL TIMEFRAME: 3M OR 5M
//────────────────────────────────────────────
isSignalTF = timeframe.isminutes and timeframe.multiplier == signalMinutes
// Do not permit new signals during the first 30 minutes after the selected
// market opening. The first eligible signal candle must open at or after +30.
entryCutoffTime = openingTime + 30 * 60 * 1000
entryWindowOpen = selectedSessionActive and time >= entryCutoffTime and time_close < closingTime
//────────────────────────────────────────────
// ACTIVE TRADE VARIABLES
//────────────────────────────────────────────
var bool longActive  = false
var bool shortActive = false
var float tradeEntry = na
var float tradeSL    = na
var float tradeTP1   = na
var float tradeTP2   = na
var bool tp1Hit = false
var bool tp2Hit = false
var bool ctcActive = false
// 0 = original SL, 1 = CTC, 2 = rejection level +/−12.5%, 3 = TP1
var int slStage = 0
var int tradeStartBar = na
var int currentTargetNumber = 1
var int currentTargetIndex = na
var float lastTargetHit = na
var bool targetLockPending = false
// Prevent a completed trade's exit candle from also creating a new entry.
var int lastTradeExitBar = na
//────────────────────────────────────────────
// PERFORMANCE COUNTERS
// $1.00 movement in gold = 10 pips for this indicator.
//────────────────────────────────────────────
var int tp1PlusTrades = 0
var int initialSLTrades = 0
var int ctcTrades = 0
var int completedTrades = 0
var float capturedDollars = 0.0
// Same-level reversal protection:
// After SL/CTC, block only the opposite direction from that same level.
// Direction: 1 = BUY, -1 = SELL.
var int activeLevelIndex = na
var int blockedLevelIndex = na
var int blockedDirection  = 0

// Direct-close level bias. After price closes through a range level, keep the
// breakout direction at that level until any different range level is touched.
// Direction: 1 = BUY bias, -1 = SELL bias, 0 = none.
var int breakoutBiasLevelIndex = na
var int breakoutBiasDirection = 0
var int breakoutBiasStartBar = na
// A setup rejected only because of poor R:R remains pending at its rejection
// level. Direction: 1 = pending BUY, -1 = pending SELL, 0 = none.
var int pendingRRDirection = 0
var int pendingRRLevelIndex = na
var int pendingRRStartBar = na
//────────────────────────────────────────────
// DRAWING OBJECTS
//────────────────────────────────────────────
var line entryLine = na
var line slLine    = na
var line tp1Line   = na
var line tp2Line   = na
var label entryLabel = na
var label slLabel    = na
var label tp1Label   = na
var label tp2Label   = na
var box riskBox = na
var box tp1Box  = na
var box tp2Box  = na
//────────────────────────────────────────────
// DELETE OLD TRADE MAP
//────────────────────────────────────────────
clearTradeMap() =>
    if not na(entryLine)
        line.delete(entryLine)
    if not na(slLine)
        line.delete(slLine)
    if not na(tp1Line)
        line.delete(tp1Line)
    if not na(tp2Line)
        line.delete(tp2Line)
    if not na(entryLabel)
        label.delete(entryLabel)
    if not na(slLabel)
        label.delete(slLabel)
    if not na(tp1Label)
        label.delete(tp1Label)
    if not na(tp2Label)
        label.delete(tp2Label)
    if not na(riskBox)
        box.delete(riskBox)
    if not na(tp1Box)
        box.delete(tp1Box)
    if not na(tp2Box)
        box.delete(tp2Box)
// Keep only one compact result label at the actual exit point
collapseTradeMap(string resultText, color resultColor, float resultPrice) =>
    if not na(entryLine)
        line.delete(entryLine)
    if not na(slLine)
        line.delete(slLine)
    if not na(tp1Line)
        line.delete(tp1Line)
    if not na(tp2Line)
        line.delete(tp2Line)
    if not na(slLabel)
        label.delete(slLabel)
    if not na(tp1Label)
        label.delete(tp1Label)
    if not na(tp2Label)
        label.delete(tp2Label)
    if not na(riskBox)
        box.delete(riskBox)
    if not na(tp1Box)
        box.delete(tp1Box)
    if not na(tp2Box)
        box.delete(tp2Box)
    if not na(entryLabel)
        label.delete(entryLabel)
    label.new(
         bar_index,
         resultPrice,
         resultText,
         style=label.style_label_left,
         color=resultColor,
         textcolor=color.white,
         size=size.small)
//────────────────────────────────────────────
// ACTIVE LONG — CONTINUE THROUGH TP1, TP2, TP3...
//────────────────────────────────────────────
if longActive
    bool slMovedThisBar = false
    line.set_x2(entryLine, bar_index)
    line.set_x2(slLine, bar_index)
    line.set_x2(tp1Line, bar_index)
    box.set_right(riskBox, bar_index)
    box.set_right(tp1Box, bar_index)
    if not ctcActive and not tp1Hit and high >= tradeEntry + 6.0
        ctcActive := true
        slMovedThisBar := true
        slStage := 1
        tradeSL := tradeEntry
        line.set_y1(slLine, tradeSL)
        line.set_y2(slLine, tradeSL)
        label.set_y(slLabel, tradeSL)
        label.set_text(slLabel, "CTC  " + str.tostring(tradeSL, format.mintick))
        label.set_color(slLabel, color.orange)
        box.set_bottom(riskBox, tradeSL)
    if targetLockPending and high >= lastTargetHit + rangeVal * trailingOffsetFactor
        targetLockPending := false
        slMovedThisBar := true
        slStage := 3
        tradeSL := lastTargetHit
        line.set_y1(slLine, tradeSL)
        line.set_y2(slLine, tradeSL)
        label.set_y(slLabel, tradeSL)
        label.set_text(slLabel, "SL AT TP" + str.tostring(currentTargetNumber - 1) + "  " + str.tostring(tradeSL, format.mintick))
        label.set_color(slLabel, color.orange)
        box.set_bottom(riskBox, tradeSL)
    for targetStep = 0 to lastLevelIndex
        if longActive and not na(tradeTP1) and high >= tradeTP1
            float hitPrice = tradeTP1
            int hitNumber = currentTargetNumber
            int hitLevelIndex = currentTargetIndex

            // A long trade closing above its reached TP creates BUY bias at
            // that TP, even though the breakout happened while trade was active.
            if close > hitPrice
                breakoutBiasLevelIndex := hitLevelIndex
                breakoutBiasDirection := 1
                breakoutBiasStartBar := bar_index
            else if breakoutBiasDirection != 0 and breakoutBiasLevelIndex != hitLevelIndex
                // Merely touching this different TP invalidates an older bias.
                breakoutBiasLevelIndex := na
                breakoutBiasDirection := 0
                breakoutBiasStartBar := na

            if hitNumber == 1
                tp1PlusTrades += 1
            tp1Hit := true
            slMovedThisBar := true
            slStage := 2
            lastTargetHit := hitPrice
            targetLockPending := true
            tradeSL := hitPrice - rangeVal * trailingOffsetFactor
            line.set_y1(slLine, tradeSL)
            line.set_y2(slLine, tradeSL)
            label.set_y(slLabel, tradeSL)
            label.set_text(slLabel, "TRAIL TP" + str.tostring(hitNumber) + "  " + str.tostring(tradeSL, format.mintick))
            label.set_color(slLabel, color.orange)
            box.set_bottom(riskBox, tradeSL)
            string bookingText = hitNumber == 1 ? " — BOOK 50%" : hitNumber == 2 ? " — BOOK 80%" : ""
            label.new(bar_index, hitPrice, "✓ TP" + str.tostring(hitNumber) + " HIT" + bookingText,
                 style=label.style_label_left, color=color.green, textcolor=color.white, size=size.small)
            int nextIndex = na
            if currentTargetIndex < lastLevelIndex
                for i = currentTargetIndex + 1 to lastLevelIndex
                    if na(nextIndex) and not na(array.get(levels, i))
                        nextIndex := i
            if na(nextIndex)
                collapseTradeMap("BUY, FINAL TP" + str.tostring(hitNumber), color.green, hitPrice)
                lastTradeExitBar := bar_index
                capturedDollars += hitPrice - tradeEntry
                completedTrades += 1
                blockedLevelIndex := na
                blockedDirection := 0
                longActive := false
            else
                currentTargetIndex := nextIndex
                currentTargetNumber += 1
                tradeTP1 := array.get(levels, nextIndex)
                line.set_y1(tp1Line, tradeTP1)
                line.set_y2(tp1Line, tradeTP1)
                label.set_y(tp1Label, tradeTP1)
                label.set_text(tp1Label, "TP" + str.tostring(currentTargetNumber) + "  " + str.tostring(tradeTP1, format.mintick))
                box.set_top(tp1Box, tradeTP1)
    if longActive and targetLockPending and high >= lastTargetHit + rangeVal * trailingOffsetFactor
        targetLockPending := false
        slMovedThisBar := true
        slStage := 3
        tradeSL := lastTargetHit
        line.set_y1(slLine, tradeSL)
        line.set_y2(slLine, tradeSL)
        label.set_y(slLabel, tradeSL)
        label.set_text(slLabel, "SL AT TP" + str.tostring(currentTargetNumber - 1) + "  " + str.tostring(tradeSL, format.mintick))
        label.set_color(slLabel, color.orange)
        box.set_bottom(riskBox, tradeSL)
    if longActive and low <= tradeSL and not slMovedThisBar
        collapseTradeMap(slStage == 0 ? "BUY, SL HIT" : slStage == 1 ? "BUY, CTC" : "BUY, TRAIL SL", slStage == 0 ? color.red : color.orange, tradeSL)
        lastTradeExitBar := bar_index
        capturedDollars += tradeSL - tradeEntry
        completedTrades += 1
        if slStage == 0
            initialSLTrades += 1
        else if slStage == 1
            ctcTrades += 1
        if not tp1Hit
            blockedLevelIndex := activeLevelIndex
            blockedDirection := 1
        else
            blockedLevelIndex := na
            blockedDirection := 0
        longActive := false
//────────────────────────────────────────────
// ACTIVE SHORT — CONTINUE THROUGH TP1, TP2, TP3...
//────────────────────────────────────────────
if shortActive
    bool slMovedThisBar = false
    line.set_x2(entryLine, bar_index)
    line.set_x2(slLine, bar_index)
    line.set_x2(tp1Line, bar_index)
    box.set_right(riskBox, bar_index)
    box.set_right(tp1Box, bar_index)
    if not ctcActive and not tp1Hit and low <= tradeEntry - 6.0
        ctcActive := true
        slMovedThisBar := true
        slStage := 1
        tradeSL := tradeEntry
        line.set_y1(slLine, tradeSL)
        line.set_y2(slLine, tradeSL)
        label.set_y(slLabel, tradeSL)
        label.set_text(slLabel, "CTC  " + str.tostring(tradeSL, format.mintick))
        label.set_color(slLabel, color.orange)
        box.set_top(riskBox, tradeSL)
    if targetLockPending and low <= lastTargetHit - rangeVal * trailingOffsetFactor
        targetLockPending := false
        slMovedThisBar := true
        slStage := 3
        tradeSL := lastTargetHit
        line.set_y1(slLine, tradeSL)
        line.set_y2(slLine, tradeSL)
        label.set_y(slLabel, tradeSL)
        label.set_text(slLabel, "SL AT TP" + str.tostring(currentTargetNumber - 1) + "  " + str.tostring(tradeSL, format.mintick))
        label.set_color(slLabel, color.orange)
        box.set_top(riskBox, tradeSL)
    for targetStep = 0 to lastLevelIndex
        if shortActive and not na(tradeTP1) and low <= tradeTP1
            float hitPrice = tradeTP1
            int hitNumber = currentTargetNumber
            int hitLevelIndex = currentTargetIndex

            // A short trade closing below its reached TP creates SELL bias at
            // that TP, even though the breakdown happened while trade was active.
            if close < hitPrice
                breakoutBiasLevelIndex := hitLevelIndex
                breakoutBiasDirection := -1
                breakoutBiasStartBar := bar_index
            else if breakoutBiasDirection != 0 and breakoutBiasLevelIndex != hitLevelIndex
                // Merely touching this different TP invalidates an older bias.
                breakoutBiasLevelIndex := na
                breakoutBiasDirection := 0
                breakoutBiasStartBar := na

            if hitNumber == 1
                tp1PlusTrades += 1
            tp1Hit := true
            slMovedThisBar := true
            slStage := 2
            lastTargetHit := hitPrice
            targetLockPending := true
            tradeSL := hitPrice + rangeVal * trailingOffsetFactor
            line.set_y1(slLine, tradeSL)
            line.set_y2(slLine, tradeSL)
            label.set_y(slLabel, tradeSL)
            label.set_text(slLabel, "TRAIL TP" + str.tostring(hitNumber) + "  " + str.tostring(tradeSL, format.mintick))
            label.set_color(slLabel, color.orange)
            box.set_top(riskBox, tradeSL)
            string bookingText = hitNumber == 1 ? " — BOOK 50%" : hitNumber == 2 ? " — BOOK 80%" : ""
            label.new(bar_index, hitPrice, "✓ TP" + str.tostring(hitNumber) + " HIT" + bookingText,
                 style=label.style_label_left, color=color.green, textcolor=color.white, size=size.small)
            int nextIndex = na
            if currentTargetIndex > 0
                for x = 0 to currentTargetIndex - 1
                    int i = currentTargetIndex - 1 - x
                    if na(nextIndex) and not na(array.get(levels, i))
                        nextIndex := i
            if na(nextIndex)
                collapseTradeMap("SELL, FINAL TP" + str.tostring(hitNumber), color.green, hitPrice)
                lastTradeExitBar := bar_index
                capturedDollars += tradeEntry - hitPrice
                completedTrades += 1
                blockedLevelIndex := na
                blockedDirection := 0
                shortActive := false
            else
                currentTargetIndex := nextIndex
                currentTargetNumber += 1
                tradeTP1 := array.get(levels, nextIndex)
                line.set_y1(tp1Line, tradeTP1)
                line.set_y2(tp1Line, tradeTP1)
                label.set_y(tp1Label, tradeTP1)
                label.set_text(tp1Label, "TP" + str.tostring(currentTargetNumber) + "  " + str.tostring(tradeTP1, format.mintick))
                box.set_bottom(tp1Box, tradeTP1)
    if shortActive and targetLockPending and low <= lastTargetHit - rangeVal * trailingOffsetFactor
        targetLockPending := false
        slMovedThisBar := true
        slStage := 3
        tradeSL := lastTargetHit
        line.set_y1(slLine, tradeSL)
        line.set_y2(slLine, tradeSL)
        label.set_y(slLabel, tradeSL)
        label.set_text(slLabel, "SL AT TP" + str.tostring(currentTargetNumber - 1) + "  " + str.tostring(tradeSL, format.mintick))
        label.set_color(slLabel, color.orange)
        box.set_top(riskBox, tradeSL)
    if shortActive and high >= tradeSL and not slMovedThisBar
        collapseTradeMap(slStage == 0 ? "SELL, SL HIT" : slStage == 1 ? "SELL, CTC" : "SELL, TRAIL SL", slStage == 0 ? color.red : color.orange, tradeSL)
        lastTradeExitBar := bar_index
        capturedDollars += tradeEntry - tradeSL
        completedTrades += 1
        if slStage == 0
            initialSLTrades += 1
        else if slStage == 1
            ctcTrades += 1
        if not tp1Hit
            blockedLevelIndex := activeLevelIndex
            blockedDirection := -1
        else
            blockedLevelIndex := na
            blockedDirection := 0
        shortActive := false

//────────────────────────────────────────────
// FORCE SAME-DAY EXIT AT 23:00 GERMANY TIME
//────────────────────────────────────────────
if selectedSessionClosingBar
    if longActive
        collapseTradeMap("BUY, DAY CLOSE", color.gray, close)
        capturedDollars += close - tradeEntry
        completedTrades += 1
        lastTradeExitBar := bar_index
        longActive := false

    if shortActive
        collapseTradeMap("SELL, DAY CLOSE", color.gray, close)
        capturedDollars += tradeEntry - close
        completedTrades += 1
        lastTradeExitBar := bar_index
        shortActive := false

    // Nothing from the selected day carries into the following session.
    pendingRRDirection := 0
    pendingRRLevelIndex := na
    pendingRRStartBar := na
    breakoutBiasLevelIndex := na
    breakoutBiasDirection := 0
    breakoutBiasStartBar := na
    blockedLevelIndex := na
    blockedDirection := 0
//────────────────────────────────────────────
// FIND BUY / SELL SETUP
//────────────────────────────────────────────
int buyIndex = na
int sellIndex = na
bool canCreateNewSignal = na(lastTradeExitBar) or bar_index > lastTradeExitBar

// Keep a direct-break bias even if price later closes back through the same
// level. Only a touch of another visible range level invalidates it.
if isSignalTF and selectedSessionActive and breakoutBiasDirection != 0 and bar_index > breakoutBiasStartBar
    bool biasTouchedAnotherLevel = false

    for i = 0 to lastLevelIndex
        float biasCheckLevel = array.get(levels, i)
        if i != breakoutBiasLevelIndex and not na(biasCheckLevel) and low <= biasCheckLevel and high >= biasCheckLevel
            biasTouchedAnotherLevel := true

    if biasTouchedAnotherLevel
        breakoutBiasLevelIndex := na
        breakoutBiasDirection := 0
        breakoutBiasStartBar := na

// When no bias is active, record the highest level crossed upward or the
// lowest level crossed downward by the candle close.
if isSignalTF and selectedSessionActive and not longActive and not shortActive and breakoutBiasDirection == 0
    int upwardBreakIndex = na
    int downwardBreakIndex = na

    for i = 0 to lastLevelIndex
        float breakoutLevel = array.get(levels, i)
        if not na(breakoutLevel) and close[1] < breakoutLevel and close > breakoutLevel
            upwardBreakIndex := i

    for x = 0 to lastLevelIndex
        int i = lastLevelIndex - x
        float breakoutLevel = array.get(levels, i)
        if not na(breakoutLevel) and close[1] > breakoutLevel and close < breakoutLevel
            downwardBreakIndex := i

    if not na(upwardBreakIndex)
        breakoutBiasLevelIndex := upwardBreakIndex
        breakoutBiasDirection := 1
        breakoutBiasStartBar := bar_index

        if pendingRRLevelIndex == upwardBreakIndex and pendingRRDirection == -1
            pendingRRDirection := 0
            pendingRRLevelIndex := na
            pendingRRStartBar := na
    else if not na(downwardBreakIndex)
        breakoutBiasLevelIndex := downwardBreakIndex
        breakoutBiasDirection := -1
        breakoutBiasStartBar := bar_index

        if pendingRRLevelIndex == downwardBreakIndex and pendingRRDirection == 1
            pendingRRDirection := 0
            pendingRRLevelIndex := na
            pendingRRStartBar := na
// Recheck a poor-R:R setup on later candles. It survives a close through the
// rejection level and expires only after price reaches the next range level on
// either side. The crossing candle that first created the pending setup is not
// used for invalidation.
if isSignalTF and entryWindowOpen and canCreateNewSignal and not longActive and not shortActive and pendingRRDirection != 0 and bar_index > pendingRRStartBar
    float pendingLevel = array.get(levels, pendingRRLevelIndex)
    float lowerBoundary = na
    float upperBoundary = na
    bool pendingBlockedByBias = pendingRRLevelIndex == breakoutBiasLevelIndex and ((pendingRRDirection == 1 and breakoutBiasDirection == -1) or (pendingRRDirection == -1 and breakoutBiasDirection == 1))
    for step = 1 to lastLevelIndex
        int lowerIndex = pendingRRLevelIndex - step
        int upperIndex = pendingRRLevelIndex + step
        if na(lowerBoundary) and lowerIndex >= 0
            float lowerCandidate = array.get(levels, lowerIndex)
            if not na(lowerCandidate)
                lowerBoundary := lowerCandidate
        if na(upperBoundary) and upperIndex <= lastLevelIndex
            float upperCandidate = array.get(levels, upperIndex)
            if not na(upperCandidate)
                upperBoundary := upperCandidate
    bool pendingBoundaryTouched = (not na(lowerBoundary) and low <= lowerBoundary) or (not na(upperBoundary) and high >= upperBoundary)
    if pendingBoundaryTouched
        pendingRRDirection := 0
        pendingRRLevelIndex := na
        pendingRRStartBar := na
    else if pendingBlockedByBias
        pendingRRDirection := 0
        pendingRRLevelIndex := na
        pendingRRStartBar := na
    else if pendingRRDirection == 1
        bool longTouchedLevel = low <= pendingLevel
        bool longRetracedToward = low < low[1]
        bool longReclaimedLevel = close[1] <= pendingLevel and close > pendingLevel
        if close > pendingLevel and (longTouchedLevel or longRetracedToward or longReclaimedLevel)
            buyIndex := pendingRRLevelIndex
    else
        bool shortTouchedLevel = high >= pendingLevel
        bool shortRetracedToward = high > high[1]
        bool shortReclaimedLevel = close[1] >= pendingLevel and close < pendingLevel
        if close < pendingLevel and (shortTouchedLevel or shortRetracedToward or shortReclaimedLevel)
            sellIndex := pendingRRLevelIndex
// Merely reaching any other range level also refreshes the blocked level.
if isSignalTF and selectedSessionActive and not longActive and not shortActive and not na(blockedLevelIndex)
    bool touchedAnotherLevel = false
    for i = 0 to lastLevelIndex
        lvl = array.get(levels, i)
        if i != blockedLevelIndex and low <= lvl and high >= lvl
            touchedAnotherLevel := true
    if touchedAnotherLevel
        blockedLevelIndex := na
        blockedDirection := 0
if isSignalTF and entryWindowOpen and canCreateNewSignal and not longActive and not shortActive and pendingRRDirection == 0
    for x = 0 to lastLevelIndex
        i = lastLevelIndex - x
        lvl = array.get(levels, i)
        fromAbove = close[1] > lvl
        touched   = low <= lvl
        closedAbove = close > lvl
        // If this level's last failed trade was SELL, only another SELL is
        // allowed here until TP or a signal from another level refreshes it.
        buyBlocked = (i == blockedLevelIndex and blockedDirection == -1) or (i == breakoutBiasLevelIndex and breakoutBiasDirection == -1)
        if fromAbove and touched and closedAbove and not buyBlocked and na(buyIndex)
            buyIndex := i
//────────────────────────────────────────────
if isSignalTF and entryWindowOpen and canCreateNewSignal and not longActive and not shortActive and pendingRRDirection == 0
    for i = 0 to lastLevelIndex
        lvl = array.get(levels, i)
        fromBelow = close[1] < lvl
        touched   = high >= lvl
        closedBelow = close < lvl
        // If this level's last failed trade was BUY, only another BUY is
        // allowed here until TP or a signal from another level refreshes it.
        sellBlocked = (i == blockedLevelIndex and blockedDirection == 1) or (i == breakoutBiasLevelIndex and breakoutBiasDirection == 1)
        if fromBelow and touched and closedBelow and not sellBlocked and na(sellIndex)
            sellIndex := i
// Don't create BUY + SELL same candle
if not na(buyIndex) and not na(sellIndex)
    buyIndex  := na
    sellIndex := na
longSignal  = not na(buyIndex)
shortSignal = not na(sellIndex)
//────────────────────────────────────────────
// CREATE LONG TRADE
//────────────────────────────────────────────
if longSignal
    // A valid setup from another level refreshes the old blocked level.
    if not na(blockedLevelIndex) and buyIndex != blockedLevelIndex
        blockedLevelIndex := na
        blockedDirection := 0
    float nextTP1 = na
    float nextTP2 = na
    int nextTP1Index = na
    int targetCandidateNumber = 0
    // Count targets from the rejected level, not from the entry candle's close.
    if buyIndex < lastLevelIndex
        for i = buyIndex + 1 to lastLevelIndex
            lvl = array.get(levels, i)
            if not na(lvl)
                targetCandidateNumber += 1
                bool useAsTP1 = lowRangeMode ? targetCandidateNumber == 2 : targetCandidateNumber == 1
                bool useAsTP2 = lowRangeMode ? targetCandidateNumber == 3 : targetCandidateNumber == 2
                if useAsTP1
                    nextTP1 := lvl
                    nextTP1Index := i
                else if useAsTP2
                    nextTP2 := lvl
    float plannedLongSL = array.get(levels, buyIndex) - initialSLOffset
    float plannedLongRisk = math.abs(close - plannedLongSL)
    float plannedLongReward = not na(nextTP1) ? math.abs(nextTP1 - close) : na
    float plannedLongRR = plannedLongRisk > 0 ? plannedLongReward / plannedLongRisk : na
    bool validLongRR = not na(plannedLongRR) and plannedLongRR >= minimumTP1RewardRisk
    if not na(nextTP1) and not validLongRR
        bool isNewPendingLong = pendingRRDirection != 1 or pendingRRLevelIndex != buyIndex
        pendingRRDirection := 1
        pendingRRLevelIndex := buyIndex
        pendingRRStartBar := isNewPendingLong ? bar_index : pendingRRStartBar
        if isNewPendingLong
            label.new(
                 bar_index,
                 high,
                 "WAIT BUY — SL ⛔\nR:R " + str.tostring(plannedLongRR, "#.##"),
                 style=label.style_label_down,
                 color=color.white,
                 textcolor=color.green,
                 size=size.small)
    if not na(nextTP1) and validLongRR
        pendingRRDirection := 0
        pendingRRLevelIndex := na
        pendingRRStartBar := na
        // Keep completed trade maps visible in chart history
        tp2Line := na
        tp2Label := na
        tp2Box := na
        tradeEntry := close
        // Initial SL uses the adjustable fixed-price offset from the rejected level.
        tradeSL := plannedLongSL
        tradeTP1 := nextTP1
        tradeTP2 := na
        // Start the rolling TP sequence from the selected TP1 level.
        currentTargetNumber := 1
        currentTargetIndex := nextTP1Index
        lastTargetHit := na
        targetLockPending := false
        tp1Hit := false
        tp2Hit := false
        ctcActive := false
        slStage := 0
        tradeStartBar := bar_index
        activeLevelIndex := buyIndex
        longActive := true
        //────────────────────────
        // ENTRY
        //────────────────────────
        entryLine := line.new(
             bar_index,
             tradeEntry,
             bar_index + 1,
             tradeEntry,
             color=color.blue,
             width=2)
        entryLabel := label.new(
             bar_index,
             tradeEntry,
             "BUY  " +
             str.tostring(tradeEntry, format.mintick),
             style=label.style_label_left,
             color=color.blue,
             textcolor=color.white)
        //────────────────────────
        // SL
        //────────────────────────
        slLine := line.new(
             bar_index,
             tradeSL,
             bar_index + 1,
             tradeSL,
             color=color.red,
             width=2)
        slLabel := label.new(
             bar_index,
             tradeSL,
             "SL  " +
             str.tostring(tradeSL, format.mintick),
             style=label.style_label_left,
             color=color.red,
             textcolor=color.white)
        //────────────────────────
        // TP1
        //────────────────────────
        tp1Line := line.new(
             bar_index,
             tradeTP1,
             bar_index + 1,
             tradeTP1,
             color=color.green,
             width=2)
        tp1Label := label.new(
             bar_index,
             tradeTP1,
             "TP1  " +
             str.tostring(tradeTP1, format.mintick),
             style=label.style_label_left,
             color=color.green,
             textcolor=color.white)
        //────────────────────────
        // BACKGROUND ZONES
        //────────────────────────
        // Risk zone
        riskBox := box.new(
             bar_index,
             tradeEntry,
             bar_index + 1,
             tradeSL,
             bgcolor=color.new(color.red, 88),
             border_color=color.new(color.red, 70))
        // Entry → TP1
        tp1Box := box.new(
             bar_index,
             tradeTP1,
             bar_index + 1,
             tradeEntry,
             bgcolor=color.new(color.green, 90),
             border_color=color.new(color.green, 70))
//────────────────────────────────────────────
// CREATE SHORT TRADE
//────────────────────────────────────────────
if shortSignal
    // A valid setup from another level refreshes the old blocked level.
    if not na(blockedLevelIndex) and sellIndex != blockedLevelIndex
        blockedLevelIndex := na
        blockedDirection := 0
    float nextTP1 = na
    float nextTP2 = na
    int nextTP1Index = na
    int targetCandidateNumber = 0
    // Count targets from the rejected level, not from the entry candle's close.
    if sellIndex > 0
        for x = 0 to sellIndex - 1
            i = sellIndex - 1 - x
            lvl = array.get(levels, i)
            if not na(lvl)
                targetCandidateNumber += 1
                bool useAsTP1 = lowRangeMode ? targetCandidateNumber == 2 : targetCandidateNumber == 1
                bool useAsTP2 = lowRangeMode ? targetCandidateNumber == 3 : targetCandidateNumber == 2
                if useAsTP1
                    nextTP1 := lvl
                    nextTP1Index := i
                else if useAsTP2
                    nextTP2 := lvl
    float plannedShortSL = array.get(levels, sellIndex) + initialSLOffset
    float plannedShortRisk = math.abs(plannedShortSL - close)
    float plannedShortReward = not na(nextTP1) ? math.abs(close - nextTP1) : na
    float plannedShortRR = plannedShortRisk > 0 ? plannedShortReward / plannedShortRisk : na
    bool validShortRR = not na(plannedShortRR) and plannedShortRR >= minimumTP1RewardRisk
    if not na(nextTP1) and not validShortRR
        bool isNewPendingShort = pendingRRDirection != -1 or pendingRRLevelIndex != sellIndex
        pendingRRDirection := -1
        pendingRRLevelIndex := sellIndex
        pendingRRStartBar := isNewPendingShort ? bar_index : pendingRRStartBar
        if isNewPendingShort
            label.new(
                 bar_index,
                 low,
                 "WAIT SELL — SL ⛔\nR:R " + str.tostring(plannedShortRR, "#.##"),
                 style=label.style_label_up,
                 color=color.white,
                 textcolor=color.red,
                 size=size.small)
    if not na(nextTP1) and validShortRR
        pendingRRDirection := 0
        pendingRRLevelIndex := na
        pendingRRStartBar := na
        // Keep completed trade maps visible in chart history
        tp2Line := na
        tp2Label := na
        tp2Box := na
        tradeEntry := close
        // Initial SL uses the adjustable fixed-price offset from the rejected level.
        tradeSL := plannedShortSL
        tradeTP1 := nextTP1
        tradeTP2 := na
        // Start the rolling TP sequence from the selected TP1 level.
        currentTargetNumber := 1
        currentTargetIndex := nextTP1Index
        lastTargetHit := na
        targetLockPending := false
        tp1Hit := false
        tp2Hit := false
        ctcActive := false
        slStage := 0
        tradeStartBar := bar_index
        activeLevelIndex := sellIndex
        shortActive := true
        // ENTRY
        entryLine := line.new(
             bar_index,
             tradeEntry,
             bar_index + 1,
             tradeEntry,
             color=color.blue,
             width=2)
        entryLabel := label.new(
             bar_index,
             tradeEntry,
             "SELL  " +
             str.tostring(tradeEntry, format.mintick),
             style=label.style_label_left,
             color=color.blue,
             textcolor=color.white)
        // SL
        slLine := line.new(
             bar_index,
             tradeSL,
             bar_index + 1,
             tradeSL,
             color=color.red,
             width=2)
        slLabel := label.new(
             bar_index,
             tradeSL,
             "SL  " +
             str.tostring(tradeSL, format.mintick),
             style=label.style_label_left,
             color=color.red,
             textcolor=color.white)
        // TP1
        tp1Line := line.new(
             bar_index,
             tradeTP1,
             bar_index + 1,
             tradeTP1,
             color=color.green,
             width=2)
        tp1Label := label.new(
             bar_index,
             tradeTP1,
             "TP1  " +
             str.tostring(tradeTP1, format.mintick),
             style=label.style_label_left,
             color=color.green,
             textcolor=color.white)
        // BACKGROUND — RISK
        riskBox := box.new(
             bar_index,
             tradeSL,
             bar_index + 1,
             tradeEntry,
             bgcolor=color.new(color.red, 88),
             border_color=color.new(color.red, 70))
        // ENTRY → TP1
        tp1Box := box.new(
             bar_index,
             tradeEntry,
             bar_index + 1,
             tradeTP1,
             bgcolor=color.new(color.green, 90),
             border_color=color.new(color.green, 70))
//────────────────────────────────────────────
// SIGNAL MARKERS
//────────────────────────────────────────────
plotshape(
     longSignal and longActive and tradeStartBar == bar_index,
     title="BUY",
     location=location.belowbar,
     style=shape.triangleup,
     color=color.lime,
     size=size.small,
     text="BUY")
plotshape(
     shortSignal and shortActive and tradeStartBar == bar_index,
     title="SELL",
     location=location.abovebar,
     style=shape.triangledown,
     color=color.red,
     size=size.small,
     text="SELL")
//────────────────────────────────────────────
// PERFORMANCE SUMMARY
// Counts use all trades processed from the selected opening onward.
//────────────────────────────────────────────
var table performanceInfo = table.new(
     position.bottom_right, 2, 6,
     bgcolor=color.new(color.black, 15),
     frame_color=color.gray,
     frame_width=1)
if barstate.islast
    float capturedPips = capturedDollars * 10.0
    table.cell(performanceInfo, 0, 0, "Completed trades", text_color=color.white)
    table.cell(performanceInfo, 1, 0, str.tostring(completedTrades), text_color=color.yellow)
    table.cell(performanceInfo, 0, 1, "Reached TP1+", text_color=color.white)
    table.cell(performanceInfo, 1, 1, str.tostring(tp1PlusTrades), text_color=color.lime)
    table.cell(performanceInfo, 0, 2, "Initial SL", text_color=color.white)
    table.cell(performanceInfo, 1, 2, str.tostring(initialSLTrades), text_color=color.red)
    table.cell(performanceInfo, 0, 3, "CTC", text_color=color.white)
    table.cell(performanceInfo, 1, 3, str.tostring(ctcTrades), text_color=color.orange)
    // table.cell(performanceInfo, 0, 4, "Captured ($)", text_color=color.white)
    // table.cell(performanceInfo, 1, 4, str.tostring(capturedDollars, "#.##"), text_color=capturedDollars >= 0 ? color.lime : color.red)
    table.cell(performanceInfo, 0, 5, "Captured (pips)", text_color=color.white)
    table.cell(performanceInfo, 1, 5, str.tostring(capturedPips, "#.0"), text_color=capturedPips >= 0 ? color.lime : color.red)
