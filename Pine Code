//@version=6

indicator("Opening Range Levels + 3M/5M Trade Map", overlay=true,

**     max_lines_count=500, max_labels_count=500, max_boxes_count=500)**

//────────────────────────────────────────────

// INPUTS

//────────────────────────────────────────────

openingTime = input.time(

**     defval=timestamp("15 Aug 2026 09:15 +0530"),**

**     title="Opening Candle Date and Time (IST)")**

// GVZopen = input.float(20.0, "GVZ Opening", minval=0.01, step=0.01)

string volatilitySymbol = "VANTAGE:VIX"

GVZopenA = request.security(

**     volatilitySymbol,**

**     "D",**

**     open,**

**     gaps=barmerge.gaps_off,**

**     lookahead=barmerge.lookahead_off)**

signalMinutes = input.int(5, "Signal Timeframe (Minutes)", options=[3, 5])

previousDayRangeThreshold = input.float(

**     85.0,**

**     "Previous Day Range Threshold ($)",**

**     minval=1.0,**

**     step=1.0)**

minimumTP1RewardRisk = input.float(

**     1.2,**

**     "Minimum TP1 Reward/Risk",**

**     minval=0.1,**

**     step=0.1)**

candles = signalMinutes == 5 ? 276 : 460

// Capture the opening price internally from 5-minute data. This keeps the

// selected opening available when the chart is switched between 3M and 5M.

selectedOpen5M = request.security(

**     syminfo.tickerid,**

**     "5",**

**     time <= openingTime and time_close > openingTime ? open : na,**

**     gaps=barmerge.gaps_off,**

**     lookahead=barmerge.lookahead_off)**

var float openPrice = na

if not na(selectedOpen5M)

**    openPrice := selectedOpen5M**



//Auto range

previousDayHigh = request.security(

**     syminfo.tickerid, "D", high[1],**

**     gaps=barmerge.gaps_off,**

**     lookahead=barmerge.lookahead_on)**

previousDayLow = request.security(

**     syminfo.tickerid, "D", low[1],**

**     gaps=barmerge.gaps_off,**

**     lookahead=barmerge.lookahead_on)**

previousDayPriceRange = previousDayHigh - previousDayLow

previousDayRange = previousDayPriceRange * 100

lowRangeMode = previousDayPriceRange < previousDayRangeThreshold

slOffsetFactor = lowRangeMode ? 0.25 : 0.125

// After TP1, every trailing step is always 12.5% in both range modes.

trailingOffsetFactor = 0.125

rangeSource = input.string(

**     "Volatility Index",**

**     "Range Source",**

**     options=["Volatility Index", "Previous Day Range"])**

GVZopen = rangeSource == "Volatility Index" ? GVZopenA : previousDayRange



//────────────────────────────────────────────

// RANGE

//────────────────────────────────────────────

rangeValA = (GVZopen / 15.87) * openPrice / 100

rangeValB = (GVZopen / candles)*1

rangeVal = GVZopen < 50 ? rangeValA : rangeValB

// Cross-check panel for the two available range sources.

var table rangeInfo = table.new(

**     position.top_right, 2, 2,**

**     bgcolor=color.new(color.black, 15),**

**     frame_color=color.gray,**

**     frame_width=1)**

if barstate.islast

**    table.cell(rangeInfo, 0, 0, "VIX opening", text_color=color.white)**

**    table.cell(rangeInfo, 1, 0, str.tostring(GVZopenA, "#.###"), text_color=color.aqua)**

**    table.cell(rangeInfo, 0, 1, "Previous H-L ($)", text_color=color.white)**

**    table.cell(rangeInfo, 1, 1, str.tostring(previousDayPriceRange*100, format.mintick), text_color=color.aqua)**

//────────────────────────────────────────────

// LEVELS

//────────────────────────────────────────────

U25  = openPrice + rangeVal * 0.25

U50  = openPrice + rangeVal * 0.50

U75  = openPrice + rangeVal * 0.75

U100 = openPrice + rangeVal

U125 = openPrice + rangeVal * 1.25

U150 = openPrice + rangeVal * 1.50

U175 = openPrice + rangeVal * 1.75

U200 = openPrice + rangeVal * 2.00

U225 = openPrice + rangeVal * 2.25

// Keep upside extensions hidden until price trades above +100%.

var bool upperExtensionsActive = false

if not upperExtensionsActive and not na(U100) and high > U100

**    upperExtensionsActive := true**

D25  = openPrice - rangeVal * 0.25

D50  = openPrice - rangeVal * 0.50

D75  = openPrice - rangeVal * 0.75

D100 = openPrice - rangeVal

D125 = openPrice - rangeVal * 1.25

D150 = openPrice - rangeVal * 1.50

D175 = openPrice - rangeVal * 1.75

D200 = openPrice - rangeVal * 2.00

D225 = openPrice - rangeVal * 2.25

// Keep downside extensions hidden until price trades below -100%.

var bool lowerExtensionsActive = false

if not lowerExtensionsActive and not na(D100) and low < D100

**    lowerExtensionsActive := true**

//────────────────────────────────────────────

// MAIN LEVEL PLOTS

//────────────────────────────────────────────

plot(openPrice, "Opening", color=color.yellow)

plot(U25, "+25%", color=color.green)

plot(U50, "+50%", color=color.green)

plot(U75, "+75%", color=color.green)

plot(U100, "+100%", color=color.green)

plot(upperExtensionsActive ? U125 : na, "+125%", color=color.aqua)

plot(upperExtensionsActive ? U150 : na, "+150%", color=color.aqua)

plot(upperExtensionsActive ? U175 : na, "+175%", color=color.aqua)

plot(upperExtensionsActive ? U200 : na, "+200%", color=color.aqua)

plot(upperExtensionsActive ? U225 : na, "+225%", color=color.aqua)

plot(D25, "-25%", color=color.red)

plot(D50, "-50%", color=color.red)

plot(D75, "-75%", color=color.red)

plot(D100, "-100%", color=color.red)

plot(lowerExtensionsActive ? D125 : na, "-125%", color=color.orange)

plot(lowerExtensionsActive ? D150 : na, "-150%", color=color.orange)

plot(lowerExtensionsActive ? D175 : na, "-175%", color=color.orange)

plot(lowerExtensionsActive ? D200 : na, "-200%", color=color.orange)

plot(lowerExtensionsActive ? D225 : na, "-225%", color=color.orange)

//────────────────────────────────────────────

// LEVEL ARRAY

// LOWEST → HIGHEST

//────────────────────────────────────────────

var levels = array.new_float(19)

array.set(levels, 0, lowerExtensionsActive ? D225 : na)

array.set(levels, 1, lowerExtensionsActive ? D200 : na)

array.set(levels, 2, lowerExtensionsActive ? D175 : na)

array.set(levels, 3, lowerExtensionsActive ? D150 : na)

array.set(levels, 4, lowerExtensionsActive ? D125 : na)

array.set(levels, 5, D100)

array.set(levels, 6, D75)

array.set(levels, 7, D50)

array.set(levels, 8, D25)

array.set(levels, 9, openPrice)

array.set(levels, 10, U25)

array.set(levels, 11, U50)

array.set(levels, 12, U75)

array.set(levels, 13, U100)

array.set(levels, 14, upperExtensionsActive ? U125 : na)

array.set(levels, 15, upperExtensionsActive ? U150 : na)

array.set(levels, 16, upperExtensionsActive ? U175 : na)

array.set(levels, 17, upperExtensionsActive ? U200 : na)

array.set(levels, 18, upperExtensionsActive ? U225 : na)

//────────────────────────────────────────────

// SELECTED SIGNAL TIMEFRAME: 3M OR 5M

//────────────────────────────────────────────

isSignalTF = timeframe.isminutes and timeframe.multiplier == signalMinutes

// Do not permit new signals during the first 20 minutes after the selected

// market opening. The first eligible signal candle must open at or after +20.

entryCutoffTime = openingTime + 30 * 60 * 1000

entryWindowOpen = time >= entryCutoffTime

//────────────────────────────────────────────

// ACTIVE TRADE VARIABLES

//────────────────────────────────────────────

var bool longActive  = false

var bool shortActive = false

var float tradeEntry = na

var float tradeSL    = na

var float tradeTP1   = na

var float tradeTP2   = na

var bool tp1Hit = false

var bool tp2Hit = false

var bool ctcActive = false

// 0 = original SL, 1 = CTC, 2 = rejection level +/−12.5%, 3 = TP1

var int slStage = 0

var int tradeStartBar = na

var int currentTargetNumber = 1

var int currentTargetIndex = na

var float lastTargetHit = na

var bool targetLockPending = false

//────────────────────────────────────────────

// PERFORMANCE COUNTERS

// $1.00 movement in gold = 10 pips for this indicator.

//────────────────────────────────────────────

var int tp1PlusTrades = 0

var int initialSLTrades = 0

var int ctcTrades = 0

var int completedTrades = 0

var float capturedDollars = 0.0

// Same-level reversal protection:

// After SL/CTC, block only the opposite direction from that same level.

// Direction: 1 = BUY, -1 = SELL.

var int activeLevelIndex = na

var int blockedLevelIndex = na

var int blockedDirection  = 0

//────────────────────────────────────────────

// DRAWING OBJECTS

//────────────────────────────────────────────

var line entryLine = na

var line slLine    = na

var line tp1Line   = na

var line tp2Line   = na

var label entryLabel = na

var label slLabel    = na

var label tp1Label   = na

var label tp2Label   = na

var box riskBox = na

var box tp1Box  = na

var box tp2Box  = na

//────────────────────────────────────────────

// DELETE OLD TRADE MAP

//────────────────────────────────────────────

clearTradeMap() =>

**    if not na(entryLine)**

**        line.delete(entryLine)**

**    if not na(slLine)**

**        line.delete(slLine)**

**    if not na(tp1Line)**

**        line.delete(tp1Line)**

**    if not na(tp2Line)**

**        line.delete(tp2Line)**

**    if not na(entryLabel)**

**        label.delete(entryLabel)**

**    if not na(slLabel)**
